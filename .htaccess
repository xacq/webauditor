# Para hosting compartido Apache 2.4. Si controla VirtualHost, use deploy/apache-web_auditor.conf.
Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|^\.git|\.(bak|old|sql|dist|log)$)">
        Require all denied
    </FilesMatch>
    <Files "api.php">
        <LimitExcept POST>
            Require all denied
        </LimitExcept>
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.(?:git|env)(?:/|$) - [F,L,NC]
    RewriteRule ^lib/ - [F,L]
</IfModule>
